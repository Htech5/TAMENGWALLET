# Copy to .env and fill in. NEVER commit .env.
# Backend only — the mobile app must never hold these keys.

# LLM (tool calling). Empty LLM_API_KEY = the rule reader in agent/parseIntent.ts.
LLM_API_KEY=
# Optional: default gpt-4o-mini, https://api.openai.com/v1, 8000 ms.
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_MS=

# On-chain (Base Sepolia testnet only)
CHAIN_ID=base-sepolia
RPC_URL=https://sepolia.base.org
# Second owner wallet; auto-sends can allocate to it. Public address only.
SAVINGS_WALLET_ADDRESS=
AGENT_WALLET_PRIVATE_KEY=
# Circle USDC on Base Sepolia.
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Alternative: Aave Base Sepolia test USDC (public faucet, 6 decimals). The recorded
# 2026-10-19 execution evidence used this token because the Circle faucet caps at
# 20 USDC per address per 2 hours: 0xba50Cd2A20f6DA35D788639E581bca8d0B5d4D5f
# Live signing is opt-in. 0 = simulated hashes; 1 = broadcast to Base Sepolia.
TAMENG_LIVE=0

# Server
PORT=3000
# sha256 of the owner PIN. Empty = demo PIN 123456.
#   node -e "console.log(require('crypto').createHash('sha256').update('123456').digest('hex'))"
APP_PIN_HASH=
# Bearer token the phone sends. Empty = demo-device.
DEVICE_TOKEN=
